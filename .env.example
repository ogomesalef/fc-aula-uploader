# Credenciais do portal administrativo.
# Use o mesmo e-mail e senha do login no admin.
# Nunca compartilhe este arquivo nem faça commit dele.
# Copie para .env (na raiz do projeto) ou ~/.config/aula-uploader/.env

PORTAL_USERNAME=seu-usuario@empresa.com
PORTAL_PASSWORD=sua-senha-aqui

# Opcional: credenciais diferentes para o segundo portal.
# Se ficarem vazias, as de cima são reaproveitadas.
# PORTAL_2_USERNAME=
# PORTAL_2_PASSWORD=

# Opcional: sobrescrever a URL de um portal.
# Só os hosts oficiais definidos em ALLOWED_HOSTS são aceitos.
# PORTAL_1_URL=
# PORTAL_2_URL=
